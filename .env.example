# --- Postgres (DWH) ---
POSTGRES_USER=dwh
POSTGRES_PASSWORD=dwh_password
POSTGRES_DB=marketplace
# Hôte vu depuis le conteneur pipeline
POSTGRES_HOST=postgres-dwh
# Port exposé sur la machine hôte
POSTGRES_PORT=5432

# --- MinIO (data lake) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=data-lake

# --- API Marketplace ---
API_URL=http://api-marketplace:5000
API_TOKEN=formation-token-2026

# --- Générateur ---
# 18000 en dev, 180000 pour le volume du cahier des charges
CATALOG_SIZE=18000
# Défauts qualité injectés (customer_id null, dates futures, doublons)
QUALITY_DEFECTS=true
# Instabilité simulée de l'API (0 = désactivé), ex. 0.05 pour 5 % de 503
API_ERROR_RATE=0
API_MAX_LATENCY_MS=0
